{
  "$schema": "https://raw.githubusercontent.com/nicegui/nicegui/main/src-tauri/tauri.conf.json",
  "productName": "TitleForge",
  "version": "1.0.0-beta.1",
  "identifier": "com.titleforge.desktop",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node server.js",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "TitleForge",
        "width": 1100,
        "height": 750,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://api.fontshare.com; font-src 'self' https://api.fontshare.com; script-src 'self'; connect-src 'self' https://titleforge-tool.netlify.app https://api.openai.com https://api.deepseek.com https://api.anthropic.com https://generativelanguage.googleapis.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["English"],
        "startMenuFolder": "TitleForge"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "resources": ["../seed-data.json", "../THIRD-PARTY-NOTICES", "../models/SmolLM2-360M-Instruct-Q4_K_M.gguf", "../models/tokenizer.json"]
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwOUE3M0U4MjgxRUU0M0EKUldRNjVCNG82SE9hSU5jcmpNR2N5Q2VJQ2Q0QXZBbnZCbk82NDc5WmphVUlyeTBFYjF6VUt2NFUK",
      "endpoints": [
        "https://titleforge-tool.netlify.app/updates.json"
      ]
    }
  }
}
